import model loop_sm-no_b_mass
define lept = l+ l- vl vl~
define bos = Z W+ W- a
define top = t t~
define bosh = Z W+ W-
generate p p > top h j $$ w+ w- [QCD]
add process p p > top h j j $$ w+ w- [QCD]

output /global/cfs/cdirs/atlas/oarakji/myFiles/output_mg5/mg_pp_th12j_5f_50TeV


######## DELIMITER (!!! NEED THIS LINE !!!) ##################


launch DUMMYPROCESS
set iseed DUMMYSEED
set nevents DUMMYNEVENTS

set ebeam1 25000
set ebeam2 25000

set pdlabel lhapdf
set lhaid 260000

set ickkw 1
set alpsfact 1.0
set chcluster False
set asrwgtflavor 5
set auto_ptj_mjj False
